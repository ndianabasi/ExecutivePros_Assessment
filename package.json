{
  "name": "executivepros-payment-assessment",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.1.0"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "workspace:check": "yarn workspaces list --verbose",
    "lint": "eslint \"services/*/{src,tests}/**/*.{js,jsx,cjs,mjs,ts,tsx}\" \"services/{api,provider,queue}/{bin,database}/**/*.{js,jsx,cjs,mjs,ts,tsx}\" \"services/frontend/scripts/**/*.{js,jsx,cjs,mjs,ts,tsx}\"",
    "format:services": "prettier --write \"services/*/{src,tests}/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\" \"services/{api,provider,queue}/{bin,database}/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\" \"services/frontend/scripts/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\"",
    "format:check:services": "prettier --check \"services/*/{src,tests}/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\" \"services/{api,provider,queue}/{bin,database}/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\" \"services/frontend/scripts/**/*.{js,jsx,cjs,mjs,ts,tsx,css}\"",
    "deploy:local": "node bin/assessment.mjs deploy:local",
    "test:all": "node bin/assessment.mjs test:all",
    "db:up": "node bin/assessment.mjs db:up",
    "db:down": "node bin/assessment.mjs db:down",
    "backup": "node bin/assessment.mjs backup",
    "restore": "node bin/assessment.mjs restore",
    "status": "node bin/assessment.mjs status",
    "stop": "node bin/assessment.mjs stop",
    "test:deployment": "node --test tests/deployment/*.test.mjs"
  },
  "lint-staged": {
    "services/*/{src,tests}/**/*.{js,jsx,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "services/*/{src,tests}/**/*.css": "prettier --write",
    "services/{api,provider,queue}/{bin,database}/**/*.{js,jsx,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "services/frontend/scripts/**/*.{js,jsx,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "63.3.3",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.2"
  }
}
