# Isolated test stack host ports. Keep these distinct from development .env ports.
NODE_ENV=test
FRONTEND_PORT=28080
DOCS_PORT=28081
PROVIDER_PORT=28082
API_PORT=28083
MAILPIT_PORT=28025

# Integration fixture listeners; keep them distinct from Compose host ports.
API_TEST_PORT=43100
PROVIDER_TEST_PORT=43101
QUEUE_TEST_PORT=43200
SMTP_TEST_PORT=43201
MAILPIT_TEST_PORT=43202
SMTP_FROM=notifications@example.test

# `yarn test:all` creates these isolated files and keeps the paths repository-relative.
PROVIDER_WEBHOOK_SECRET_FILE=./.local/test-secrets/provider_webhook_secret
PROVIDER_SERVICE_SECRET_FILE=./.local/test-secrets/provider_service_secret
QUEUE_SERVICE_SECRET_FILE=./.local/test-secrets/queue_service_secret
