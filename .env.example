# Host-local browser origins. Internal service URLs use Compose DNS names.
NODE_ENV=development
PORT=3000
API_DB_PATH=/data/api.db
API_PUBLIC_ORIGIN=http://127.0.0.1:18083
FRONTEND_ORIGIN=http://127.0.0.1:18080
DOCS_ORIGIN=http://127.0.0.1:18081
PROVIDER_BASE_URL=http://provider:3000
PROVIDER_PUBLIC_ORIGIN=http://127.0.0.1:18082
PROVIDER_DB_PATH=/data/payment_provider.db
API_WEBHOOK_URL=http://api:3000/v1/webhooks/payment
QUEUE_BASE_URL=http://queue:3000
QUEUE_TIMEOUT_MS=5000
OUTBOX_INTERVAL_MS=5000
OUTBOX_RETRY_INITIAL_MS=1000
OUTBOX_RETRY_MAX_MS=300000
JOB_BATCH_SIZE=100
SSE_HEARTBEAT_MS=15000
JOBS_DB_PATH=/data/jobs.db
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notifications@example.test

# Compose mounts these files as read-only secrets. Keep secret contents out of this file.
PROVIDER_WEBHOOK_SECRET_FILE=/run/secrets/provider_webhook_secret
PROVIDER_SERVICE_SECRET_FILE=/run/secrets/provider_service_secret
QUEUE_SERVICE_SECRET_FILE=/run/secrets/queue_service_secret
