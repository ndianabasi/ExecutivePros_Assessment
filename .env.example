# Host port assignments are authoritative. Compose derives browser URLs from these values.
FRONTEND_PORT=18080
DOCS_PORT=18081
PROVIDER_PORT=18082
API_PORT=18083
MAILPIT_PORT=18025
NODE_ENV=development
PORT=3000
API_DB_PATH=/data/api.db
PROVIDER_DB_PATH=/data/payment_provider.db
QUEUE_TIMEOUT_MS=5000
OUTBOX_INTERVAL_MS=5000
OUTBOX_RETRY_INITIAL_MS=1000
OUTBOX_RETRY_MAX_MS=300000
RECONCILE_INTERVAL_MS=60000
RECONCILE_GRACE_MS=30000
PAYMENT_EXPIRY_DAYS=30
JOB_BATCH_SIZE=100
SSE_HEARTBEAT_MS=15000
JOBS_DB_PATH=/data/jobs.db
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=notifications@example.test

# Run `yarn deploy:local` to create these ignored secret files on first deployment.
# Compose resolves .local/secrets relative to this file on Windows, Linux, and macOS.
# Keep secret contents out of this file; container paths below remain Linux paths.
PROVIDER_WEBHOOK_SECRET_FILE=/run/secrets/provider_webhook_secret
PROVIDER_SERVICE_SECRET_FILE=/run/secrets/provider_service_secret
QUEUE_SERVICE_SECRET_FILE=/run/secrets/queue_service_secret
