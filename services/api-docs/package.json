{
  "name": "@executivepros/api-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.1.0"
  },
  "scripts": {
    "lint": "yarn --cwd ../.. eslint services/api-docs/src",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import=tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import=tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "build": "tsc && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "swagger-ui-dist": "5.33.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.0.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
